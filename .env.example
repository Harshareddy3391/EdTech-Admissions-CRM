# ==============================================================================
# EdTech CRM & Student Admissions Inquiry System - Environment Variables
# Copy this file to .env before starting the backend or frontend services.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Python FastAPI)
# ------------------------------------------------------------------------------
# Server host and port for the FastAPI uvicorn runner
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_ENV="development" # development | staging | production

# Database Connection URL (Standard SQLAlchemy format)
# For SQLite (default local file):
DATABASE_URL="sqlite:///./edtech_crm.db"
# For PostgreSQL (production or containerized deployment):
# DATABASE_URL="postgresql://edtech_user:secure_password@localhost:5432/edtech_crm_db"

# Allowed CORS Origins (comma-separated list for Vite frontend)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://ais-dev-p4janbs4mbdujfhzeoidao-740955152646.asia-east1.run.app"

# ------------------------------------------------------------------------------
# Frontend Configuration (React.js + Vite)
# ------------------------------------------------------------------------------
# Base URL for backend API requests (proxied or direct)
VITE_API_BASE_URL="/api"

# AI Studio App Hosting URL (automatically populated in deployment)
APP_URL="https://ais-dev-p4janbs4mbdujfhzeoidao-740955152646.asia-east1.run.app"
